+    "\n",
+    "    rasterio.features.shapes traces pixel edges exactly, so neighbouring\n",
+    "    fields share their edges (no gaps, no overlaps) and coordinates come out\n",
+    "    directly in the image CRS. Non-georeferenced images stay in pixel\n",
+    "    coordinates with crs=None (the old code mislabelled them as EPSG:4326).\n",
+    "    \"\"\"\n",
+    "    try:\n",
+    "        with rasterio.open(image_path) as src:\n",
+    "            transform, crs = src.transform, src.crs\n",
+    "    except Exception:\n",
+    "        transform, crs = rasterio.Affine.identity(), None\n",
+    "    georef = crs is not None and transform != rasterio.Affine.identity()\n",
+    "    if not georef:\n",
+    "        transform, crs = rasterio.Affine.identity(), None\n",
+    "        print('  ⚠ Image has no geotransform — polygons are in pixel coordinates')\n",
+    "\n",
+    "    px_size   = abs(transform.a) if georef else 1.0\n",
+    "    tolerance = config['smooth_epsilon'] * px_size\n",
+    "\n",
+    "    parts = {}\n",
+    "    for geom, value in rasterio.features.shapes(labels.astype(np.int32),\n",
+    "                                                mask=labels > 0, transform=transform):\n",
+    "        parts.setdefault(int(value), []).append(shape(geom))\n",
+    "\n",
+    "    areas = np.bincount(labels.ravel())\n",
+    "    rows, geoms = [], []\n",
+    "    for field_id, polys in sorted(parts.items()):\n",
+    "        g = unary_union(polys)\n",
+    "        if isinstance(g, MultiPolygon):\n",
+    "            g = max(g.geoms, key=lambda p: p.area)\n",
+    "        g = g.simplify(tolerance, preserve_topology=True)\n",
+    "        if g.is_empty:\n",
+    "            continue\n",
+    "        rows.append({'field_id': field_id,\n",
+    "                     'area_px':  int(areas[field_id]),\n",
+    "                     'area_m2':  round(g.area, 2) if georef and crs.is_projected else None})\n",
+    "        geoms.append(g)\n",
+    "\n",
+    "    gdf = gpd.GeoDataFrame(rows, geometry=geoms, crs=crs)\n",
+    "    print(f'  GeoDataFrame: {len(gdf)} fields  |  CRS={gdf.crs}')\n",
+    "    return gdf"
