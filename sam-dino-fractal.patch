+   "source": [
+    "# Roboflow coco-segmentation layout:\n",
+    "#   <dataset.location>/\n",
+    "#     train/  _annotations.coco.json  *.jpg\n",
+    "#     valid/  _annotations.coco.json  *.jpg\n",
