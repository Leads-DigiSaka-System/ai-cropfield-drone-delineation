+    "    @torch.no_grad()\n",
+    "    def forward(self, x: torch.Tensor):\n",
+    "        B, _, H, W = x.shape\n",
+    "        gh, gw = H // 16, W // 16\n",
+    "        x = (x * self.in_std + self.in_mean - self.mean) / self.std\n",
+    "        size = (gh * self.patch, gw * self.patch)\n",
